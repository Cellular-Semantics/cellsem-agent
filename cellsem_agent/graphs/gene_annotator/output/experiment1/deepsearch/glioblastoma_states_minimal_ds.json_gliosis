                            "reference": "Cheng F, Guo D et al. J Exp Clin Cancer Res. 2019;38:270.",
                            "id": "PMID:31221203",
                            "type": "PMID",
                            "notes": "MET/HGF signaling drives GBM proliferation and survival ([pmc.ncbi.nlm.nih.gov](https://pmc.ncbi.nlm.nih.gov/articles/PMC6585013/#:~:text=MET%20and%20its%20ligand%20hepatocyte,this%20pathway%20and%20associated%20molecules))"
                        }
