        {
          "ontology_id": "GO:0045202",
          "name": "synapse",
          "ontology_label": "cellular_component",
          "citation": [
            {
              "reference": "Venkatesh H.S. et al., Nature, 2019",
              "id": "DOI:10.1038/s41586-019-1563-y",
              "type": "DOI",
              "notes": "Provided the first evidence that glioma cells form functional post-synaptic structures receiving input from presynaptic neurons, indicating that glioblastoma cells can reside at synaptic junctions and be electrically integrated into neural circuits ([pmc.ncbi.nlm.nih.gov](https://pmc.ncbi.nlm.nih.gov/articles/PMC7850064/#:~:text=The%20recent%20discovery%20of%20synaptic,cycle%20of%20enhanced%20neuronal%20activity))"
