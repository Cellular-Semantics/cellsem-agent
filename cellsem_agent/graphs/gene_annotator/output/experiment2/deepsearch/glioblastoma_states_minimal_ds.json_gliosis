                    "name": "negative regulation of immune response",
                    "ontology_label": "biological_process",
                    "citation": [
                        {
                            "reference": "Jung et al., Neuro Oncol Adv (2022)",
                            "id": "35990703",
                            "type": "PMID",
                            "notes": "Interferon-\u03b3 induces glioblastoma cells to upregulate PD-L1 and IDO1, resulting in enhanced immunosuppressive effects on monocytes and T cells ([pmc.ncbi.nlm.nih.gov](https://pmc.ncbi.nlm.nih.gov/articles/PMC9389426/#:~:text=IFN,exposed%20GBM%20EVs%20on%20monocytes))."
                        }
                    ],
